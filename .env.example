# Copy this file to ".env" and fill in what you use. Everything here is optional
# except the Freelancer token — without it, that one source is skipped and the
# Arabic marketplaces still run.

# --- Freelancer.com -------------------------------------------------------
# Register a free app at https://www.freelancer.com/developers, generate an
# OAuth token, and paste it below.
FREELANCER_OAUTH_TOKEN=

# --- AI fit scoring (config.yaml -> ai.provider: anthropic) ---------------
# Only needed for the hosted provider. The "ollama" provider runs locally and
# needs no key at all.
ANTHROPIC_API_KEY=

# --- Alerts (config.yaml -> notify.enabled: true) -------------------------
# Telegram: create a bot with @BotFather, then message it once and read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: host/port/addresses live in config.yaml; only the credentials go here.
SMTP_USER=
SMTP_PASSWORD=

# --- Optional: route scraper traffic through a proxy -------------------------
# mostaql.com and khamsat.com (both Hsoub, same AWS load balancer) began
# returning a flat HTTP 403 on 2026-08-04. Verified it is NOT fixable in code:
# richer Chrome headers, a different TLS stack (curl) and full Chrome JA3
# impersonation are all refused identically, including on the bare homepage.
# That makes it an IP/region-level deny rule.
#
# Setting HTTPS_PROXY here is enough — httpx is built with trust_env=True and
# .env is loaded before any fetch, so every scraper picks it up with no code
# change. Point it at an egress in a region the sites accept.
# HTTPS_PROXY=http://user:pass@host:port
